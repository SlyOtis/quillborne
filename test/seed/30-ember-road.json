      "number": 2,
      "played_at": "2026-10-31",
      "body": "{\"blocks\":[{\"id\":\"es2a\",\"kind\":\"heading\",\"text\":\"Recap\",\"options\":{\"level\":2}},{\"id\":\"es2b\",\"kind\":\"paragraph\",\"text\":\"Old Tamsin, the last lamplighter, swore she saw a figure with a burning hand walk out of the fog. By morning her lamp was cold and she was gone.\",\"options\":{}},{\"id\":\"es2c\",\"kind\":\"todo\",\"text\":\"Follow the soot trail east of the bridge\",\"options\":{\"done\":false}}]}",
