      "tags": [
        "arc one"
      ],
      "number": 1,
      "played_at": "2026-10-17",
      "body": "{\"blocks\":[{\"id\":\"es1a\",\"kind\":\"heading\",\"text\":\"Recap\",\"options\":{\"level\":2}},{\"id\":\"es1b\",\"kind\":\"paragraph\",\"text\":\"Reeve Halda Morrow hired the company at the Drowned Lantern. On the road north, bandits in ash-grey cloaks held Cinder Bridge and demanded a toll in lamp oil.\",\"options\":{}},{\"id\":\"es1c\",\"kind\":\"bullet\",\"text\":\"Wren picked the toll-keeper's pocket and found a map of every lamp post in Hollowmere.\",\"options\":{}},{\"id\":\"es1d\",\"kind\":\"bullet\",\"text\":\"The bandits fled into the fog rather than fight.\",\"options\":{}}]}",
      "share_campaigns": [
        "${ember}"
      ]
    }
