    { "id": "frightened", "title": "Frightened", "description": "Disadvantage on checks and attacks while the source is in sight, and cannot move closer to it." },
    { "id": "grappled", "title": "Grappled", "description": "Speed becomes 0." },
    { "id": "incapacitated", "title": "Incapacitated", "description": "Cannot take actions or reactions." },
    { "id": "invisible", "title": "Invisible", "description": "Cannot be seen without magic. Your attacks have advantage, attacks against you disadvantage." },
    { "id": "paralyzed", "title": "Paralyzed", "description": "Incapacitated, cannot move or speak, fails Strength and Dexterity saves; hits within 5 ft are critical." },
    { "id": "petrified", "title": "Petrified", "description": "Turned to stone, incapacitated, resistant to all damage." },
    { "id": "poisoned", "title": "Poisoned", "description": "Disadvantage on attack rolls and ability checks." },
    { "id": "prone", "title": "Prone", "description": "Crawl only; disadvantage on attacks; melee attacks against you have advantage." },
    { "id": "restrained", "title": "Restrained", "description": "Speed 0, disadvantage on attacks and Dexterity saves; attacks against you have advantage." },
    { "id": "stunned", "title": "Stunned", "description": "Incapacitated, cannot move, fails Strength and Dexterity saves." },
    { "id": "unconscious", "title": "Unconscious", "description": "Incapacitated, drops what it holds, falls prone; hits within 5 ft are critical." }
