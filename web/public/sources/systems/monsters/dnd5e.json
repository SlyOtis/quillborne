  "formulas": {
    "modifier": "floor((score - 10) / 2)",
    "save": "mod + prof * tier",
    "skill": "mod + prof * tier",
    "passivePerception": "10 + skill.perception",
    "initiative": "mod.dex + prof * tier",
    "initiativeScore": "10 + initiative",
    "hitPoints": "max(1, floor(dice * (die + 1) / 2) + dice * mod.con)",
    "hitBonus": "dice * mod.con",
    "attack": "mod + prof + bonus",
    "dc": "8 + mod + prof + bonus",
    "damage": "mod * ability + bonus",
    "average": "max(0, floor(dice * (die + 1) / 2) + flat)",
    "rolledHitPoints": "max(1, roll + hitBonus)",
    "recharged": "roll >= recharge"
  },
